# Lactice — copy to .env.local. Product limits (docs/01 §6, docs/15 §2). Defaults shown.
NEXT_PUBLIC_APP_NAME=Lactice

TRIAL_LIMIT_ENABLED=true        # false = no trial limit (budget kill switch still applies)
TRIAL_LIMIT_MINUTES=5           # one-time per account
SESSION_TARGET_MINUTES=5        # soft limit: tutor finishes the exchange, then wraps up
SESSION_GRACE_SECONDS=120
AI_MONTHLY_BUDGET_USD=50
SILENCE_HINT_PULSE_SECONDS=10
SILENCE_NUDGE_SECONDS=25
UNCLEAR_MAX_RETRIES=1
MAX_RECORDING_SECONDS=30
MIN_SPEECH_MS=400
IDLE_PAUSE_SECONDS=90
RECONNECT_WINDOW_SECONDS=120
TRIAL_ACCOUNTS_PER_IP_PER_DAY=3
MAX_LEARNER_TURNS=40

# Provider keys are added in Phase 0 (never commit real values)
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
